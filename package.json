{
  "name": "drais",
  "productName": "DRAIS",
  "description": "DRAIS — academic, attendance and biometric platform for schools",
  "author": {
    "name": "DRAIS",
    "email": "info@drais.pro"
  },
  "version": "2.14.9",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "build:webpack": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:permissions": "node scripts/lint-permissions.mjs",
    "typecheck": "tsc --noEmit",
    "test:biometric": "npx tsx --test src/lib/biometric/__tests__/*.test.mjs",
    "test:drce": "npx tsx --test src/lib/drce/__tests__/*.test.mjs",
    "test:snapshots": "npx tsx --test src/lib/snapshots/__tests__/*.test.mjs",
    "verify:divisions": "node scripts/db/verify-snapshot-divisions.mjs",
    "test:ingestion": "npx tsx --test src/lib/ingestion/__tests__/*.test.mjs",
    "test:attendance": "npx tsx --test src/lib/attendance/__tests__/*.test.mjs",
    "test:notifications": "npx tsx --test src/lib/notifications/__tests__/*.test.mjs",
    "test:sentinel": "npx tsx --test src/lib/sentinel/__tests__/*.test.mjs",
    "test:comm": "npx tsx --test src/lib/comm/__tests__/*.test.mjs",
    "test": "npm run test:biometric && npm run test:drce && npm run test:snapshots && npm run test:ingestion && npm run test:attendance && npm run test:notifications && npm run test:sentinel && npm run test:comm",
    "sentinel:scan": "node scripts/sentinel/architecture-scan.mjs",
    "gate": "node scripts/phase-stability-gate.mjs",
    "zip": "node scripts/zip-project.mjs",
    "import:schema": "node scripts/import-schema.js",
    "db:export:schema": "node scripts/db/export-schema.mjs",
    "db:export:full": "node scripts/db/export-full.mjs",
    "db:export:albayan": "node scripts/db/export-albayan.mjs",
    "db:local:to-mysql8": "node scripts/db/to-mysql8.mjs",
    "db:local:init": "node scripts/db/local-init.mjs",
    "db:local:verify": "node scripts/db/local-verify.mjs",
    "setup:tidb": "bash scripts/setup-tidb.sh",
    "trash:verify": "npx tsx scripts/verify-trash-descriptors.mts",
    "vercel-build": "NODE_OPTIONS=--max_old_space_size=2560 npm run build",
    "vercel-api": "next start",
    "build:electron": "next build && node scripts/postbuild-electron.mjs",
    "electron:dev": "npm run build:electron && electron .",
    "dist:win": "npm run build:electron && electron-builder --win --x64",
    "dist:win:portable": "npm run build:electron && electron-builder --win portable --x64",
    "dist:dir": "npm run build:electron && electron-builder --dir",
    "dist:linux": "npm run build:electron && electron-builder --linux AppImage deb",
    "dist:snap": "npm run build:electron && electron-builder --linux snap",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "mobile:build": "node scripts/build-mobile.mjs",
    "cap:add:android": "npx cap add android",
    "mobile:stage-node": "node scripts/stage-node-android.mjs",
    "mobile:sync": "node scripts/build-mobile.mjs && npx cap sync android && node scripts/stage-node-android.mjs",
    "mobile:apk:debug": "cd android && ./gradlew assembleDebug",
    "mobile:apk:release": "cd android && ./gradlew assembleRelease",
    "mobile:install:debug": "cd android && ./gradlew installDebug",
    "mobile:open": "npx cap open android",
    "version:bump": "node scripts/bump-version.mjs",
    "postinstall": "node scripts/install-hooks.mjs",
    "db:seed:albayan-fees": "node scripts/db/seed-albayan-fees.mjs",
    "test:passouts": "npx tsx --test src/lib/passouts/__tests__/*.test.mjs",
    "test:allocations": "npx tsx --test src/lib/academics/__tests__/*.test.mjs",
    "test:repo": "npx tsx --test src/lib/repo/__tests__/*.test.mjs",
    "test:provisioning": "npx tsx --test src/lib/provisioning/__tests__/*.test.mjs",
    "provisioning:provision-school": "npx tsx scripts/provisioning/provision-school.mts",
    "test:container": "npx tsx --test src/lib/container/__tests__/*.test.mjs",
    "brand:icons": "node scripts/brand/generate-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
