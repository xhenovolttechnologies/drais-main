    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.3.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.22",
    "hash-wasm": "^4.12.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.6",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.541.0",
    "multer": "^2.0.2",
    "mysql2": "^3.22.3",
    "next": "^15.5.12",
    "next-auth": "^4.24.11",
    "next-i18next": "^15.4.2",
    "node-zklib": "^1.3.0",
    "nodejs-mobile-cordova": "^0.4.3",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.17.2",
    "puppeteer": "^24.17.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.10",
    "react-is": "^19.2.8",
    "react-toastify": "^11.0.5",
